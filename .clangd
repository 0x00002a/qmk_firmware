CompileFlags:
    Add:
        [
            -Wno-unknown-attributes,
            -Wno-maybe-uninitialized,
            -Wno-unknown-warning-option,
            -Wno-pointer-to-int-cast,
            -Wno-int-to-void-pointer-cast,
            -DPROGMEM=,
        ]
    Remove:
        [
            -W*,
            -mmcu=*,
            -mcpu=*,
            -mfpu=*,
            -mfloat-abi=*,
            -mno-unaligned-access,
            -mno-thumb-interwork,
            -mcall-prologues,
            -D__has_include*,
            -mlra,
        ]
    Compiler: clang
Diagnostics:
    UnusedIncludes: None
    Suppress:
        [
            asm_invalid_output_constraint,
            asm_invalid_input_constraint,
            invalid_asm_value_for_constraint,
            anyx86_interrupt_attribute,
        ]

---
If:
  PathMatch: .*\.inc
CompileFlags:
  Add:
    - -xc
    - -includergb_matrix.h
    - -includelib/lib8tion/lib8tion.h
    - -DRGB_MATRIX_CUSTOM_EFFECT_IMPLS
    - -DRGB_MATRIX_EFFECT(name)=
    - -Wno-unused-function
